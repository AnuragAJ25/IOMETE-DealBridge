# IOMETE DealBridge Environment Configuration (Placeholders only)

# Next.js Application Port
PORT=3000

# Presentation Session Mode
NEXT_PUBLIC_APP_NAME="IOMETE DealBridge"
NEXT_PUBLIC_APP_TAGLINE="Make Complex Technology Easy to Understand, Evaluate & Buy"
NEXT_PUBLIC_DEFAULT_ROLE="seller"

# Backend FastAPI Service (Deployments use Render backend; local dev falls back to http://localhost:8000)
# Production: NEXT_PUBLIC_API_URL="https://iomete-dealbridge-backend.onrender.com"
NEXT_PUBLIC_API_URL="https://iomete-dealbridge-backend.onrender.com"

# Google Gemini API Key (Integration in upcoming step)
GEMINI_API_KEY="your_gemini_api_key_here"
